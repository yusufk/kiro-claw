TELEGRAM_BOT_TOKEN=
TRIGGER_PATTERN=@jarvis
KIRO_AGENT=JARVIS
CONTAINER_IMAGE=kiro-claw-agent:latest
CONTAINER_TIMEOUT=300
BRAIN_DIR=
EXTRA_HOSTS=
ALLOWED_CHAT_IDS=
OWNER_CHAT_ID=
JARVIS_CHAT_ID=
PROJECTS=

# Optional: host paths to a local mempalace venv + palace, mounted into the
# container for FRIDAY's memory. Leave blank on machines without a local
# mempalace (mounts are skipped when unset or the path does not exist).
MEMPALACE_VENV=
MEMPALACE_PALACE=

# Webhook security
WEBHOOK_SECRET=
WEBHOOK_ALLOWED_IPS=127.0.0.1,192.168.1.125
WEBHOOK_PORT=8099

# MCP secrets — injected as env vars into container (never written to config files)
MCP_HOME_ASSISTANT_API_ACCESS_TOKEN=
MCP_MCP_OBSIDIAN_OBSIDIAN_API_KEY=
MCP_WORDPRESS_MASJID_WP_API_PASSWORD=
